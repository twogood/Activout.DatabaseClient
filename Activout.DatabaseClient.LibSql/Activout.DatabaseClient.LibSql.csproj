<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>default</LangVersion>
        <TargetFramework>net10.0</TargetFramework>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>Activout Database Client - libSQL backend</Title>
        <Description>libSQL (Turso, Bunny Database) and SQLite backend for Activout.DatabaseClient.</Description>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.89"/>
        <PackageReference Include="Nelknet.LibSQL.Data" Version="0.2.13"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Activout.DatabaseClient\Activout.DatabaseClient.csproj"/>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
