{
  "metadata": [{
    "src": [{ "src": "..", "files": ["Activout.DatabaseClient/*.csproj", "Activout.DatabaseClient.Dapper/*.csproj"] }],
    "dest": "api"
  }],
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/toc.yml", "index.md", "toc.yml"] }
